# Port the API listens on. Defaults to 4000; Railway sets its own.
PORT=4000
# MongoDB connection string used by the dev server and in production.
MONGO_URI=
# Separate MongoDB database for `pnpm test` (used only when NODE_ENV=test). Never point it at real data: tests wipe it.
MONGO_URI_TEST=
# Secret used to sign the login JWTs (HS256). Use a long random string.
tokenKey=
# TMDb API key, used to look up film posters.
TMDb_API_KEY=
# Shared token the client sends in the server-authorization header. Checked only when NODE_ENV=production; must match the client's VITE_SERVER_AUTH_TOKEN.
SERVER_AUTH_TOKEN=
# Google OAuth Web client ID for "Sign in with Google". Same value as the client's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
# Optional: requests per minute per IP before rate limiting (default 20).
# RATE_LIMIT_PER_MINUTE=
# Set to `production` in production (enables the SERVER_AUTH_TOKEN check).
# NODE_ENV=production
