{
  "name": "drama-keeper",
  "version": "1.0.0",
  "description": "Keep a record of the films watched",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app": "concurrently \"pnpm dev\" \"pnpm --dir client dev\"",
    "lint": "eslint .",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "repository": "https://github.com/Ruberoni/drama-keeper",
  "author": "Ruben Paredes",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "axios": "^1.21.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "google-auth-library": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.5",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.1.3",
    "@vitest/eslint-plugin": "^1.6.28",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
