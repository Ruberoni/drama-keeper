{
  "name": "drama-keeper",
  "version": "1.0.0",
  "description": "Keep a record of the films watched",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "app": "concurrently \"pnpm dev\" \"pnpm --dir client dev\"",
    "eslint-staged": "LIST=`git diff --cached --name-only | grep .*\\.ts | grep -v json`; if [ \"$LIST\" ]; then eslint $LIST && prettier $LIST --write; fi"
  },
  "engines": {
    "node": ">=26 <27"
  },
  "repository": "https://github.com/Ruberoni/drama-keeper",
  "author": "Ruben Paredes",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "axios": "^0.21.1",
    "bcrypt": "^5.0.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "debug": "^4.3.1",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-rate-limit": "^5.2.6",
    "google-auth-library": "^11.3.2",
    "helmet": "^4.6.0",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.12.3",
    "validator": "^13.5.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.5",
    "@types/express": "^4.17.25",
    "@types/express-rate-limit": "^5.1.1",
    "@types/jsonwebtoken": "^8.5.1",
    "@types/node": "^26.6.6",
    "@types/supertest": "^2.0.11",
    "@types/validator": "^13.1.3",
    "@typescript-eslint/eslint-plugin": "^4.20.0",
    "@typescript-eslint/parser": "^4.20.0",
    "concurrently": "^6.0.2",
    "eslint": "^7.23.0",
    "eslint-config-prettier": "^8.1.0",
    "prettier": "^2.2.1",
    "supertest": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1"
}
